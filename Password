#include <iostream>
#include <string>
#include <cctype>
using namespace std;

int main() {
 string password, confirmPassword;
 int attempts = 0;
 bool valid = false;

 // Allow up to 3 attempts to create a valid password
 while (attempts < 3 && !valid) {
 cout << "Enter a password: ";
 cin >> password;

 bool hasUpper = false;
 bool hasLower = false;
 bool hasDigit = false;

 // Check password length
 if (password.length() >= 8 && password.length() <= 20) {

 // Check each character
 for (char ch : password) {
 if (isupper(ch))
 hasUpper = true;
 else if (islower(ch))
 hasLower = true;
 else if (isdigit(ch))
 hasDigit = true;
 }

 // Verify requirements
 if (hasUpper && hasLower && hasDigit) {
 valid = true;
 }
 }

 // If password is invalid
 if (!valid) {
 attempts++;

 cout << "\nInvalid password!" << endl;
 cout << "Attempt " << attempts
 << " of 3 used. "
 << (3 - attempts) << " attempt(s) remaining.\n" << endl;
 }
 }

 // If a valid password was entered
 if (valid) {
 cout << "\nPassword accepted!" << endl;

 int confirmAttempts = 0;
 bool match = false;

 // Allow up to 3 attempts to re-enter the password
 while (confirmAttempts < 3 && !match) {
 cout << "Re-enter your password: ";
 cin >> confirmPassword;

 if (password == confirmPassword) {
 match = true;
 cout << "Passwords match."
 << endl;
 } else {
 confirmAttempts++;

 cout << "\nPasswords do not match!" << endl;
 cout << "Attempt " << confirmAttempts
 << " of 3 used. "
 << (3 - confirmAttempts)
 << " attempt(s) remaining.\n" << endl;
 }
 }

 // If all confirmation attempts are used
 if (!match) {
 cout << "Maximum confirmation attempts reached. Account not created."
 << endl;
 }
 } else {
 cout << "Maximum password attempts reached. Access denied." << endl;
 }

 return 0;
}
